# Copy to backend/.env. Never commit .env.
# With docker compose (from the repo root): docker compose --env-file backend/.env up -d
# Inside docker, services reach each other by service name; the docker values are shown
# under each setting. Tests run from your machine use localhost.
ENVIRONMENT=local

ASYNC_DB_URL=your_async_db_url
# docker: postgresql+asyncpg://postgres:postgres@disputepilot_postgres:5432/disputepilot  # pragma: allowlist secret

SYNC_DB_URL=your_sync_db_url
# docker: postgresql://postgres:postgres@disputepilot_postgres:5432/disputepilot  # pragma: allowlist secret

ASYNC_TEST_DB_URL=your_async_test_db_url
# docker postgres, from your machine: postgresql+asyncpg://postgres:postgres@localhost:5432/disputepilot_test  # pragma: allowlist secret

REDIS_URL=your_redis_url
# docker: redis://disputepilot_redis:6379/0
REDIS_MAX_CONNECTIONS=200

BROKER_URL=your_rabbitmq_url
# docker: amqp://guest:guest@disputepilot_broker:5672/vhost  # pragma: allowlist secret

# sender address must be on a domain verified in resend
API_EMAIL=DisputePilot <no-reply@your_verified_domain>
RESEND_API_KEY=your_resend_api_key

# generate fernet key using -> Fernet.generate_key()
ENCRYPTION_KEY=your_encryption_key

ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key

# replace with integer values
ACCESS_TOKEN_EXPIRE_TIME=your_access_token_expire_minutes
REFRESH_TOKEN_EXPIRE_TIME=your_refresh_token_expire_days

# generate using -> secrets.token_urlsafe(32)
OTP_SECRET_KEY=your_otp_secret_key

FRONTEND_URL=http://localhost:3000
# public url of this api for the paystack webhook (an ngrok url in development)
BACKEND_URL=http://localhost:8000
# docker ngrok service: your ngrok token and reserved domain (BACKEND_URL=https://<it>)
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_URL=your_ngrok_domain

# generate using -> secrets.token_urlsafe(32)
SESSION_SECRET_KEY=your_session_secret_key

# optional, e.g. https://api.example.com/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

ARGON2_PASSWORD_PEPPER=your_argon2_password_pepper

# Minio (host:port, no scheme); docker: disputepilot_minio:9000
# the docker minio uses MINIO_ACCESS_KEY / MINIO_SECRET_KEY as its root user
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false
MINIO_REGION=eu-west-1
MINIO_BUCKET=disputepilot

# live updates (GET /events); comma separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
ACCESS_TOKEN_COOKIE_NAME=access_token
EVENT_STREAM_MAXLEN=500
EVENT_STREAM_TTL_SECONDS=86400
EVENT_HEARTBEAT_SECONDS=20
EVENT_MAX_STREAMS_PER_MERCHANT=5
AI_MEMORY_CONTEXT_LIMIT=20
