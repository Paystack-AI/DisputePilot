# Copy to ai/.env. Never commit .env.
BACKBOARD_API_KEY=your_actual_api_key

# Redis shared with the backend; the stream names must match the backend's settings
# docker: redis://disputepilot_redis:6379/0 (compose sets it for the ai service)
REDIS_URL=redis://localhost:6379/0
AI_REQUEST_STREAM=ai:stream:requests
AI_RESULT_STREAM=ai:stream:results
AI_REQUEST_GROUP=ai
# unique per worker instance, stable across restarts
AI_REQUEST_CONSUMER=ai-1

# LLM provider keys; a provider with an empty key is skipped
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER_ORDER=gemini,groq

# Models default to the Gemini free tier and Groq's free tier. Change these values
# (or upgrade the API key) to move to a paid plan; no code change is needed.
GEMINI_MODEL_CLASSIFIER=gemini-3.8-flash
GEMINI_MODEL_EVIDENCE=gemini-3.8-flash
GEMINI_MODEL_SCORER=gemini-3.8-flash
GEMINI_MODEL_TRUST_EXPLAIN=gemini-3.8-flash
GEMINI_MODEL_TRUST_RECOMMEND=gemini-3.8-flash
GEMINI_MODEL_TRUST_STATE_CHANGE=gemini-3.8-flash
GROQ_MODEL_CLASSIFIER=openai/gpt-oss-120b
GROQ_MODEL_EVIDENCE=openai/gpt-oss-120b
GROQ_MODEL_SCORER=openai/gpt-oss-120b
GROQ_MODEL_TRUST_EXPLAIN=openai/gpt-oss-120b
GROQ_MODEL_TRUST_RECOMMEND=openai/gpt-oss-120b
GROQ_MODEL_TRUST_STATE_CHANGE=openai/gpt-oss-120b

# per-task generation settings
CLASSIFIER_TEMPERATURE=0.1
EVIDENCE_TEMPERATURE=0.3
SCORER_TEMPERATURE=0.1
TRUST_TEMPERATURE=0.1
CLASSIFIER_MAX_TOKENS=500
EVIDENCE_MAX_TOKENS=2000
SCORER_MAX_TOKENS=500
TRUST_MAX_TOKENS=500

# provider chain behaviour
LLM_ATTEMPT_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=2
LLM_JSON_RETRY_ATTEMPTS=1
LLM_PROVIDER_COOLDOWN_SECONDS=60
LLM_PROVIDER_FAILURE_THRESHOLD=3
LLM_HEALTH_KEY_PREFIX=ai:llm:health
