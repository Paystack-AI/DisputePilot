# Copy to .env.production, generate unique values for every secret, and keep the
# resulting file out of version control. Do not reuse local development credentials.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ENVIRONMENT=production
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=disputepilot
POSTGRES_USER=disputepilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
ASYNC_DB_URL=postgresql+asyncpg://disputepilot:replace-with-a-long-random-password@postgres:5432/disputepilot
SYNC_DB_URL=postgresql://disputepilot:replace-with-a-long-random-password@postgres:5432/disputepilot
ASYNC_TEST_DB_URL=postgresql+asyncpg://disputepilot:replace-with-a-long-random-password@postgres:5432/disputepilot_test

RABBITMQ_DEFAULT_USER=disputepilot
RABBITMQ_DEFAULT_PASS=replace-with-a-different-long-random-password
BROKER_URL=amqp://disputepilot:replace-with-a-different-long-random-password@broker:5672/disputepilot
REDIS_URL=redis://redis:6379/0

# Pin this to the S3-compatible image/version tested for your deployment.
S3_IMAGE=pgsty/silo:replace-with-a-pinned-version
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=replace-with-a-unique-storage-access-key
MINIO_SECRET_KEY=replace-with-a-different-long-random-secret
MINIO_SECURE=false
MINIO_REGION=eu-west-1
MINIO_BUCKET=disputepilot

API_EMAIL=DisputePilot <no-reply@example.com>
RESEND_API_KEY=replace-me
ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key
ACCESS_TOKEN_SECRET_KEY=replace-me-with-a-unique-random-secret
REFRESH_TOKEN_SECRET_KEY=replace-me-with-a-different-random-secret
ACCESS_TOKEN_EXPIRE_TIME=15
REFRESH_TOKEN_EXPIRE_TIME=30
OTP_SECRET_KEY=replace-me-with-a-unique-random-secret
SESSION_SECRET_KEY=replace-me-with-a-unique-random-secret
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
ARGON2_PASSWORD_PEPPER=replace-me-with-a-unique-random-secret

GOOGLE_REDIRECT_URI=https://app.example.com/api/proxy/auth/google/callback
